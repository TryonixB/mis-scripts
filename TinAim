local gui = Instance.new("ScreenGui")
gui.Name = "TinAimGui"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local main = Instance.new("Frame")
main.Size = UDim2.new(0, 340, 0, 300)
main.Position = UDim2.new(0.5, -170, 0.5, -150)
main.BackgroundColor3 = C.bg
main.BorderSizePixel = 0
main.Parent = gui
mkCorner(main, 12)
mkStroke(main, C.stroke, 1)

local top = Instance.new("Frame")
top.Size = UDim2.new(1, 0, 0, 38)
top.BackgroundColor3 = C.top
top.Parent = main
mkCorner(top, 12)

mkLabel(top, "TIN AIM", UDim2.new(0, 140, 0, 26), UDim2.new(0, 14, 0, 6), 16, C.text, Enum.Font.GothamBold)

local minBtn = mkBtn(top, "-", UDim2.new(0, 30, 0, 26), UDim2.new(1, -72, 0, 6), C.btn, nil)
minBtn.TextSize = 18

local maxBtn = mkBtn(top, "+", UDim2.new(0, 30, 0, 26), UDim2.new(1, -38, 0, 6), C.btn, nil)
maxBtn.TextSize = 18

local content = Instance.new("Frame")
content.Size = UDim2.new(1, 0, 1, -38)
content.Position = UDim2.new(0, 0, 0, 38)
content.BackgroundTransparency = 1
content.Parent = main

ui.btnToggle = mkBtn(content, "AIMBOT: OFF", UDim2.new(0, 300, 0, 46), UDim2.new(0, 20, 0, 16), C.off, function()
	setEnabled(not state.enabled)
end)

ui.lblTarget = mkLabel(content, "Objetivo: --", UDim2.new(0, 300, 0, 24), UDim2.new(0, 20, 0, 76), 14, C.accent, Enum.Font.GothamBold)

mkLabel(content, " tecla I: alternar aimbot", UDim2.new(0, 300, 0, 22), UDim2.new(0, 20, 0, 102), 12, C.muted)

-- FOV
local fovLbl = mkLabel(content, "FOV: " .. CFG.fovDeg .. "°", UDim2.new(0, 200, 0, 24), UDim2.new(0, 20, 0, 134), 14, C.text)
mkBtn(content, "-", UDim2.new(0, 36, 0, 26), UDim2.new(0, 20, 0, 160), C.btn, function()
	CFG.fovDeg = math.max(5, CFG.fovDeg - 5)
	fovLbl.Text = "FOV: " .. CFG.fovDeg .. "°"
end)
mkBtn(content, "+", UDim2.new(0, 36, 0, 26), UDim2.new(0, 62, 0, 160), C.btn, function()
	CFG.fovDeg = math.min(180, CFG.fovDeg + 5)
	fovLbl.Text = "FOV: " .. CFG.fovDeg .. "°"
end)

-- Suavizado
local smoothLbl = mkLabel(content, "Suavizado: " .. CFG.smooth, UDim2.new(0, 200, 0, 24), UDim2.new(0, 180, 0, 134), 14, C.text)
mkBtn(content, "-", UDim2.new(0, 36, 0, 26), UDim2.new(0, 180, 0, 160), C.btn, function()
	CFG.smooth = math.max(0.05, CFG.smooth - 0.05)
	smoothLbl.Text = "Suavizado: " .. math.floor(CFG.smooth * 100) / 100
end)
mkBtn(content, "+", UDim2.new(0, 36, 0, 26), UDim2.new(0, 222, 0, 160), C.btn, function()
	CFG.smooth = math.min(1, CFG.smooth + 0.05)
	smoothLbl.Text = "Suavizado: " .. math.floor(CFG.smooth * 100) / 100
end)

-- Parte del objetivo
local partBtn = mkBtn(content, "PARTE: " .. CFG.targetPart, UDim2.new(0, 300, 0, 34), UDim2.new(0, 20, 0, 202), C.accent, function()
	CFG.targetPart = (CFG.targetPart == "Head") and "HumanoidRootPart" or "Head"
	partBtn.Text = "PARTE: " .. CFG.targetPart
end)

mkLabel(content, "Apunta con la camara al objetivo dentro del FOV.", UDim2.new(0, 300, 0, 24), UDim2.new(0, 20, 0, 248), 12, C.muted)

--------------------------------------------------
-- MINIMIZAR / AGRANDAR
--------------------------------------------------
local FULL_SIZE  = UDim2.new(0, 340, 0, 300)
local MIN_SIZE   = UDim2.new(0, 340, 0, 38)
local FULL_POS   = UDim2.new(0.5, -170, 0.5, -150)
local MIN_POS    = UDim2.new(0.5, -170, 0.5, -19)

local function setMinimized(v)
	main.Size = v and MIN_SIZE or FULL_SIZE
	main.Position = v and MIN_POS or FULL_POS
	content.Visible = not v
	minBtn.Visible = not v
	maxBtn.Visible = v
end

minBtn.MouseButton1Click:Connect(function()
	setMinimized(true)
end)
maxBtn.MouseButton1Click:Connect(function()
	setMinimized(false)
end)
maxBtn.Visible = false

-- Arrastrar desde la barra superior
local dragging, dragStart, startPos
top.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
	end
end)
UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local d = input.Position - dragStart
		local newPos = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y
		)
		main.Position = newPos
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

setEnabled(false)
print("TIN AIM cargado. Tecla I para alternar.")
